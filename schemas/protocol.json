{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Draft Zcash merchant payment types",
  "description": "Select the appropriate $defs entry. Semantic/crypto validation remains mandatory.",
  "oneOf": [
    {
      "$ref": "#/$defs/merchant"
    },
    {
      "$ref": "#/$defs/invoice"
    },
    {
      "$ref": "#/$defs/registry"
    },
    {
      "$ref": "#/$defs/registrationProof"
    },
    {
      "$ref": "#/$defs/protectedHeader"
    }
  ],
  "$defs": {
    "paymentKey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "algorithm": {
          "const": "Ed25519"
        },
        "publicKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "networks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "mainnet",
              "testnet"
            ]
          }
        },
        "notBefore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kid",
        "algorithm",
        "publicKey",
        "networks",
        "notBefore",
        "expiresAt"
      ]
    },
    "merchant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "origins": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^https://[a-z0-9.-]+$"
          }
        },
        "status": {
          "enum": [
            "active",
            "suspended"
          ]
        },
        "paymentKeys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/paymentKey"
          }
        }
      },
      "required": [
        "version",
        "id",
        "name",
        "origins",
        "status",
        "paymentKeys"
      ]
    },
    "invoice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "registryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "merchantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "kid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "origin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^https://[a-z0-9.-]+$"
        },
        "network": {
          "enum": [
            "mainnet",
            "testnet"
          ]
        },
        "invoiceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "issuedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "paymentUri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "pattern": "^zcash:"
        },
        "challenge": {
          "type": "string",
          "minLength": 1,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      },
      "required": [
        "version",
        "registryId",
        "merchantId",
        "kid",
        "origin",
        "network",
        "invoiceId",
        "issuedAt",
        "expiresAt",
        "paymentUri"
      ]
    },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "merchantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "kid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "revokedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reason": {
          "enum": [
            "compromised",
            "retired",
            "ownership-change",
            "policy"
          ]
        }
      },
      "required": [
        "merchantId",
        "kid",
        "revokedAt",
        "reason"
      ]
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "registryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "issuedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sourceCommit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "merchants": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/merchant"
          }
        },
        "revocations": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/revocation"
          }
        }
      },
      "required": [
        "version",
        "registryId",
        "sequence",
        "issuedAt",
        "expiresAt",
        "sourceCommit",
        "merchants",
        "revocations"
      ]
    },
    "registrationProof": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "registryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "merchantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "kid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "origin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^https://[a-z0-9.-]+$"
        },
        "recordSha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "challenge": {
          "type": "string",
          "minLength": 1,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "issuedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "version",
        "registryId",
        "merchantId",
        "kid",
        "origin",
        "recordSha256",
        "challenge",
        "issuedAt",
        "expiresAt"
      ]
    },
    "protectedHeader": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alg": {
          "const": "Ed25519"
        },
        "typ": {
          "enum": [
            "zcash-merchant-invoice+jws",
            "zcash-merchant-registry+jws",
            "zcash-merchant-registration+jws"
          ]
        },
        "kid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        }
      },
      "required": [
        "alg",
        "typ",
        "kid"
      ]
    }
  }
}
