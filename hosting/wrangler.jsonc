{
  "name": "zucchini-merchant-registry",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-27",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": { "bindings": [{ "name": "REGISTRY", "class_name": "RegistryStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RegistryStore"] }],
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true }
}
